# Configuración de la aplicación
APP_NAME="Sistema de Inventario de Equipos Informaticos"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Conexión a MongoDB (Local o MongoDB Atlas)
# Ejemplo local: mongodb://localhost:27017
# Ejemplo Atlas: mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="inventario_equipos_db"
MONGODB_COLLECTION="equipos"
